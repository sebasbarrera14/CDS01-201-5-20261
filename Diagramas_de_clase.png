</span></span><span><span></span><span class="token token" style="color: rgb(204, 123, 244);">def</span><span> </span><span class="token token" style="color: rgb(112, 184, 255);">registrar_pedido</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>cliente</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> ClienteApp</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> carrito</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> CarritoApp</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span> </span><span class="token token" style="color: rgb(234, 236, 240);">-</span><span class="token token" style="color: rgb(234, 236, 240);">&gt;</span><span> Optional</span><span class="token token" style="color: rgb(211, 215, 222);">[</span><span>PedidoApp</span><span class="token token" style="color: rgb(211, 215, 222);">]</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>    </span><span class="token token triple-quoted-string" style="color: rgb(155, 233, 99);">"""
</span></span><span>    Registra un pedido a partir del carrito del cliente.
</span><span>    Retorna el pedido creado o None si hay error.
</span><span><span class="token token triple-quoted-string" style="color: rgb(155, 233, 99);">    """</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] SI carrito.items ESTÁ VACÍO → error</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">if</span><span> </span><span class="token token" style="color: rgb(204, 123, 244);">not</span><span> carrito</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>items</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>        logger</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>error</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"El carrito no tiene productos"</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span><span>        </span><span class="token token" style="color: rgb(204, 123, 244);">return</span><span> </span><span class="token token" style="color: rgb(94, 237, 237);">None</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] PARA cada item EN carrito.items HACER → verificar stock</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">for</span><span> item </span><span class="token token" style="color: rgb(204, 123, 244);">in</span><span> carrito</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>items</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>        </span><span class="token token" style="color: rgb(204, 123, 244);">if</span><span> </span><span class="token token" style="color: rgb(204, 123, 244);">not</span><span> item</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>producto</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>hay_disponibilidad</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>item</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>cantidad</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>            logger</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>error</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"Sin stock suficiente para: %s"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> item</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>producto</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>nombre</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span><span>            </span><span class="token token" style="color: rgb(204, 123, 244);">return</span><span> </span><span class="token token" style="color: rgb(94, 237, 237);">None</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] total ← LLAMAR carrito.calcular_total()</span><span>
</span></span><span><span>    total </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> carrito</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>calcular_total</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] pedido ← NUEVO Pedido(cliente, carrito)</span><span>
</span></span><span><span>    id_pedido </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">int</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>datetime</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>now</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>timestamp</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span><span>    pedido </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> PedidoApp</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>id_pedido</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> cliente</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">list</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>carrito</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>items</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> total</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] PARA cada item EN pedido.items HACER → reducir_stock</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">for</span><span> item </span><span class="token token" style="color: rgb(204, 123, 244);">in</span><span> pedido</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>items</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>        item</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>producto</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>reducir_stock</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>item</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>cantidad</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] LLAMAR carrito.vaciar()</span><span>
</span></span><span><span>    carrito</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>vaciar</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] ESCRIBIR "Pedido registrado con éxito"</span><span>
</span></span><span><span>    logger</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>info</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"Pedido #%s registrado — Total: $%s"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> pedido</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>id_pedido</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> </span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">f"</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">{</span><span class="token token string-interpolation interpolation">total</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">:</span><span class="token token string-interpolation interpolation format-spec">,.0f</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">}</span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">"</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] RETORNAR pedido</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">return</span><span> pedido
</span></span><span>
</span><span>
</span><span><span></span><span class="token token" style="color: rgb(129, 136, 152);"># ──────────────────────────────────────────────────────────────</span><span>
</span></span><span><span></span><span class="token token" style="color: rgb(129, 136, 152);"># Función 2: procesar_pago</span><span>
</span></span><span><span></span><span class="token token" style="color: rgb(129, 136, 152);"># ──────────────────────────────────────────────────────────────</span><span>
</span></span><span><span></span><span class="token token" style="color: rgb(204, 123, 244);">def</span><span> </span><span class="token token" style="color: rgb(112, 184, 255);">procesar_pago</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>pedido</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> PedidoApp</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> metodo_pago</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">str</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> monto</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">float</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span> </span><span class="token token" style="color: rgb(234, 236, 240);">-</span><span class="token token" style="color: rgb(234, 236, 240);">&gt;</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">bool</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>    </span><span class="token token triple-quoted-string" style="color: rgb(155, 233, 99);">"""
</span></span><span>    Procesa el pago de un pedido.
</span><span>    Retorna True si el pago fue aprobado, False si fue rechazado.
</span><span><span class="token token triple-quoted-string" style="color: rgb(155, 233, 99);">    """</span><span>
</span></span><span><span>    METODOS_VALIDOS </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> </span><span class="token token" style="color: rgb(211, 215, 222);">[</span><span class="token token" style="color: rgb(155, 233, 99);">"tarjeta"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> </span><span class="token token" style="color: rgb(155, 233, 99);">"pse"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> </span><span class="token token" style="color: rgb(155, 233, 99);">"efecty"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> </span><span class="token token" style="color: rgb(155, 233, 99);">"nequi"</span><span class="token token" style="color: rgb(211, 215, 222);">]</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] Validar que el pedido existe y su estado es "pendiente"</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">if</span><span> pedido </span><span class="token token" style="color: rgb(204, 123, 244);">is</span><span> </span><span class="token token" style="color: rgb(94, 237, 237);">None</span><span> </span><span class="token token" style="color: rgb(204, 123, 244);">or</span><span> pedido</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>estado </span><span class="token token" style="color: rgb(234, 236, 240);">!=</span><span> </span><span class="token token" style="color: rgb(155, 233, 99);">"pendiente"</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>        logger</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>error</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"El pedido no existe o no está en estado 'pendiente'"</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span><span>        </span><span class="token token" style="color: rgb(204, 123, 244);">return</span><span> </span><span class="token token" style="color: rgb(94, 237, 237);">False</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] Validar método de pago</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">if</span><span> metodo_pago </span><span class="token token" style="color: rgb(204, 123, 244);">not</span><span> </span><span class="token token" style="color: rgb(204, 123, 244);">in</span><span> METODOS_VALIDOS</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>        logger</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>error</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"Método de pago no válido: %s"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> metodo_pago</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span><span>        </span><span class="token token" style="color: rgb(204, 123, 244);">return</span><span> </span><span class="token token" style="color: rgb(94, 237, 237);">False</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] Validar que el monto coincide con el total del pedido</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">if</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">abs</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>monto </span><span class="token token" style="color: rgb(234, 236, 240);">-</span><span> pedido</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>total</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span> </span><span class="token token" style="color: rgb(234, 236, 240);">&gt;</span><span> </span><span class="token token" style="color: rgb(94, 237, 237);">0.01</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>        logger</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>error</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"El monto $%s no coincide con el total del pedido $%s"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span>
</span></span><span><span>                     </span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">f"</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">{</span><span class="token token string-interpolation interpolation">monto</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">:</span><span class="token token string-interpolation interpolation format-spec">,.0f</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">}</span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> </span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">f"</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">{</span><span class="token token string-interpolation interpolation">pedido</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">.</span><span class="token token string-interpolation interpolation">total</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">:</span><span class="token token string-interpolation interpolation format-spec">,.0f</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">}</span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">"</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span><span>        </span><span class="token token" style="color: rgb(204, 123, 244);">return</span><span> </span><span class="token token" style="color: rgb(94, 237, 237);">False</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] Simular procesamiento con pasarela (aquí siempre True para la demo)</span><span>
</span></span><span><span>    pago_aprobado </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> </span><span class="token token" style="color: rgb(94, 237, 237);">True</span><span>  </span><span class="token token" style="color: rgb(129, 136, 152);"># En producción: llamada real a la API de pago</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] SI aprobado → cambiar estado del pedido a "pagado"</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">if</span><span> pago_aprobado</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>        pedido</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>cambiar_estado</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"pagado"</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span><span>        logger</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>info</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"Pago aprobado con %s — Pedido #%s en estado 'pagado'"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span>
</span></span><span><span>                    metodo_pago</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> pedido</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>id_pedido</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] RETORNAR resultado</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">return</span><span> pago_aprobado
</span></span><span>
</span><span>
</span><span><span></span><span class="token token" style="color: rgb(129, 136, 152);"># ──────────────────────────────────────────────────────────────</span><span>
</span></span><span><span></span><span class="token token" style="color: rgb(129, 136, 152);"># Función 3: notificar_estado</span><span>
</span></span><span><span></span><span class="token token" style="color: rgb(129, 136, 152);"># ──────────────────────────────────────────────────────────────</span><span>
</span></span><span><span></span><span class="token token" style="color: rgb(204, 123, 244);">def</span><span> </span><span class="token token" style="color: rgb(112, 184, 255);">notificar_estado</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>pedido</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> PedidoApp</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> nuevo_estado</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">str</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span> </span><span class="token token" style="color: rgb(234, 236, 240);">-</span><span class="token token" style="color: rgb(234, 236, 240);">&gt;</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">str</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>    </span><span class="token token triple-quoted-string" style="color: rgb(155, 233, 99);">"""
</span></span><span>    Actualiza el estado de un pedido y retorna el mensaje de notificación.
</span><span><span class="token token triple-quoted-string" style="color: rgb(155, 233, 99);">    """</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] Validar que nuevo_estado es permitido y la transición es válida</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">try</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>        pedido</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>cambiar_estado</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>nuevo_estado</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">except</span><span> ValueError </span><span class="token token" style="color: rgb(204, 123, 244);">as</span><span> e</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>        logger</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>error</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"Error al cambiar estado: %s"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> e</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span><span>        </span><span class="token token" style="color: rgb(204, 123, 244);">raise</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] Construir mensaje de notificación</span><span>
</span></span><span><span>    mensaje </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> </span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">f"Estimado/a </span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">{</span><span class="token token string-interpolation interpolation">pedido</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">.</span><span class="token token string-interpolation interpolation">cliente</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">.</span><span class="token token string-interpolation interpolation">nombre</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">}</span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">, "</span><span>
</span></span><span><span>               </span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">f"su pedido #</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">{</span><span class="token token string-interpolation interpolation">pedido</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">.</span><span class="token token string-interpolation interpolation">id_pedido</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">}</span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);"> "</span><span>
</span></span><span><span>               </span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">f"ahora está en estado: </span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">{</span><span class="token token string-interpolation interpolation">nuevo_estado</span><span class="token token string-interpolation interpolation" style="color: rgb(211, 215, 222);">}</span><span class="token token string-interpolation" style="color: rgb(155, 233, 99);">"</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] ESCRIBIR (simular envío de correo)</span><span>
</span></span><span><span>    logger</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>info</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"Notificación enviada a %s: %s"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> pedido</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>cliente</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>correo</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> mensaje</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span>
</span><span><span>    </span><span class="token token" style="color: rgb(129, 136, 152);">## [PS] RETORNAR confirmación</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">return</span><span> mensaje
</span></span><span>
</span><span>
</span><span><span></span><span class="token token" style="color: rgb(204, 123, 244);">print</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"✅ Funciones definidas. Ejecuta la Celda 8 para probar el flujo completo."</span><span class="token token" style="color: rgb(211, 215, 222);">)</span></span></code></pre></div></div>
