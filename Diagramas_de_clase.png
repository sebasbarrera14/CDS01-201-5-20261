</span><span>
</span><span><span></span><span class="token token" style="color: rgb(129, 136, 152);"># ── Pruebas de Registro ──────────────────────────────────────</span><span>
</span></span><span><span></span><span class="token token" style="color: rgb(204, 123, 244);">def</span><span> </span><span class="token token" style="color: rgb(112, 184, 255);">test_registro_exitoso</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
</span></span><span><span>    </span><span class="token token triple-quoted-string" style="color: rgb(155, 233, 99);">"""RF-001: Registro con datos válidos."""</span><span>
</span></span><span><span>    response </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> client</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>post</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"/auth/registro"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> json</span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span class="token token" style="color: rgb(211, 215, 222);">{</span><span>
</span></span><span><span>        </span><span class="token token" style="color: rgb(155, 233, 99);">"nombre"</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> </span><span class="token token" style="color: rgb(155, 233, 99);">"María García"</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span>
