</span></span><span><span>        db</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>close</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span>
</span><span><span>app</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>dependency_overrides</span><span class="token token" style="color: rgb(211, 215, 222);">[</span><span>get_db</span><span class="token token" style="color: rgb(211, 215, 222);">]</span><span> </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> override_get_db
