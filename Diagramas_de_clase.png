</span></span><span><span>    </span><span class="token token" style="color: rgb(204, 123, 244);">assert</span><span> </span><span class="token token" style="color: rgb(155, 233, 99);">"id_cliente"</span><span> </span><span class="token token" style="color: rgb(204, 123, 244);">in</span><span> response</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>json</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span>
</span><span>
