</span></span><span><span>        self</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>correo</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">str</span><span>               </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> correo
</span></span><span><span>        self</span><span class="token token" style="color: rgb(211, 215, 222);">.</span><span>contrasena_hash</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> </span><span class="token token" style="color: rgb(251, 173, 96);">str</span><span>      </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> contrasena_hash
